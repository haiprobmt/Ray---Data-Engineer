# Set these in your process environment. Ray never auto-loads .env files.
SENIOR_DE_CODEX_BIN=
RAY_FAB_BIN=
RAY_DATA_DIR=
# Optional Telegram token. Prefer current-user DPAPI via ray secret-set on Windows.
RAY_TELEGRAM_BOT_TOKEN=
# User/chat/project access is configured in gateway YAML, not environment variables.
